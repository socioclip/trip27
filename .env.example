# Duffel access token. Use a TEST token (duffel_test_...) while developing.
# Leave empty to run with the built-in demo data (no real flights).
DUFFEL_ACCESS_TOKEN=

# Path the site is served under (sarfaraz27.vercel.app/trip27). Empty = site root.
NEXT_PUBLIC_BASE_PATH=/trip27

# Currency shown to customers. Prices from Duffel in another currency are
# converted for display using the rates below (AED per 1 unit).
DISPLAY_CURRENCY=AED
FX_RATES_TO_AED=USD:3.6725,EUR:4.28,GBP:4.93,SAR:0.979,QAR:1.009,KWD:11.98,BHD:9.74,OMR:9.55

# Optional service fee added on top of the airline fare (AED, per booking).
SERVICE_FEE_AED=0

# With a LIVE Duffel token, bookings are paid from your Duffel balance and
# real tickets are issued. Only enable after connecting a payment gateway.
ALLOW_LIVE_BOOKINGS=false
