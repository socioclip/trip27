# Duffel access token. Use a TEST token (duffel_test_...) while developing.
# Leave empty to run with the built-in demo data (no real flights).
DUFFEL_ACCESS_TOKEN=

# Path the site is served under (e.g. /trip27). Empty = site root, as on trip27.me.
NEXT_PUBLIC_BASE_PATH=

# Currency shown to customers. Prices from Duffel in another currency are
# converted for display using the rates below (AED per 1 unit).
DISPLAY_CURRENCY=AED
FX_RATES_TO_AED=USD:3.6725,EUR:4.28,GBP:4.93,SAR:0.979,QAR:1.009,KWD:11.98,BHD:9.74,OMR:9.55

# Optional service fee added on top of the airline fare (AED, per booking).
SERVICE_FEE_AED=0

# With a LIVE Duffel token, bookings are paid from your Duffel balance and
# real tickets are issued. Only enable after connecting a payment gateway.
ALLOW_LIVE_BOOKINGS=false

# Booking confirmation emails via Resend (resend.com). Leave empty to disable.
RESEND_API_KEY=
# Sender, e.g. "trip27 <bookings@yourdomain.com>" (domain must be verified in Resend).
# For testing without a domain use "trip27 <onboarding@resend.dev>" (only delivers to your own Resend account email).
EMAIL_FROM=
# Optional: where customer replies go, and a copy of every confirmation for you.
EMAIL_REPLY_TO=
EMAIL_BCC=

# Checkout.com card payments (Flow). Leave empty to disable.
# CKO_API_URL is your account's base URL from Dashboard > Developers > Overview.
CKO_API_URL=
CKO_PUBLIC_KEY=
CKO_SECRET_KEY=
CKO_PROCESSING_CHANNEL_ID=
CKO_ENVIRONMENT=sandbox

# Jinko (gojinko.com) — a second flight source next to Duffel.
# Jinko fares are paid on Jinko's own hosted checkout page (Stripe), not Checkout.com.
# Keys come from https://dashboard.gojinko.com/developers/keys (sandbox and live keys differ).
JINKO_API_KEY_SANDBOX=
JINKO_API_KEY_PROD=
# Currency Jinko prices and charges in. USD is the safe default; confirm AED with Jinko before using it.
JINKO_CURRENCY=USD
# (Older setup: a single JINKO_API_KEY, used for the environment JINKO_ENV names — sandbox unless JINKO_ENV=production.)

# Supplier switches (admin page at /admin and admin.<your domain>).
# Which suppliers answer searches is stored in Vercel Global Config (formerly Edge Config), key "suppliers".
# GLOBAL_CONFIG is added automatically when you connect a store to the project (EDGE_CONFIG also works).
GLOBAL_CONFIG=
# A Vercel access token that can write to that store (Account Settings > Tokens).
VERCEL_API_TOKEN=
# (VERCEL_API_KEY is accepted as the same thing.)
# Only if the Global Config store belongs to a Vercel team.
VERCEL_TEAM_ID=
# Who may open the admin page: comma-separated emails (they sign in with the normal email code).
ADMIN_EMAILS=
